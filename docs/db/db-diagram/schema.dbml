  updated_at    timestamptz    [not null]
  payment_id    bigint         [not null, ref: > payments.id]
  settlement_id bigint         [not null, ref: > owner_settlements.id]
  amount        decimal(12, 2) [not null]

  indexes {
    created_at
    payment_id
    settlement_id
  }

  Note: 'Append-only allocation of paid rent to one agreement month.'
}

Table rent_coverage_allocations {
  id                 bigint         [pk, increment]
  created_at         timestamptz    [not null]
  updated_at         timestamptz    [not null]
  payment_id         bigint         [not null, ref: > payments.id]
  owner_agreement_id bigint         [not null, ref: > owner_agreements.id]
  start_date         date           [not null]
  end_date           date           [not null]
  amount             decimal(12, 2) [not null]

  indexes {
    created_at
    payment_id
    owner_agreement_id
  }

  Note: 'Agreement/date allocation for one anniversary-period rent payment.'
}

// iDeal DBML Domain: Inventory (app: inventory)

Table inventory_acts {
  id                   bigint                  [pk, increment]
  created_at           timestamptz             [not null]
  updated_at           timestamptz             [not null]
  deleted_at           timestamptz            
  restored_at          timestamptz            
  transaction_id       uuid                   
  property_id          bigint                  [not null, ref: > properties.id]
  lease_id             bigint                  [ref: > leases.id]
  act_type             inventory_acts_act_type [not null, default: 'general']
  status               inventoryact_status     [not null, default: 'finalized']
  created_by_id        bigint                  [not null, ref: > users.id]
  notes                text                   
  finalized_at         timestamptz            
  acknowledged_by_name varchar(200)           
  acknowledged_at      timestamptz            
  acknowledgment_note  text                   

  indexes {
    created_at
    deleted_at
    property_id
    lease_id
    created_by_id
    property_id [name: 'inventory_a_propert_cc7dfa_idx']
    lease_id [name: 'inventory_a_lease_i_cf64d4_idx']
    status [name: 'inventory_a_status_37a6cc_idx']
  }

  Note: 'Digital passportization: a structured condition record (Akt) for a property.'
}

Table inventory_act_items {
  id             bigint                        [pk, increment]
  created_at     timestamptz                   [not null]
  updated_at     timestamptz                   [not null]
  deleted_at     timestamptz                  
  restored_at    timestamptz                  
  transaction_id uuid                         
  act_id         bigint                        [not null, ref: > inventory_acts.id]
  area           varchar(120)                  [not null]
  condition      inventory_act_items_condition [not null, default: 'good']
  notes          text                         
  sort_order     smallint                      [not null, default: 0]

  indexes {
    created_at
    deleted_at
    act_id
    act_id [name: 'inventory_a_act_id_f4b518_idx']
  }
}

Table inventory_act_photos {
  id             bigint       [pk, increment]
  created_at     timestamptz  [not null]
  updated_at     timestamptz  [not null]
  deleted_at     timestamptz 
  restored_at    timestamptz 
  transaction_id uuid        
  act_id         bigint       [not null, ref: > inventory_acts.id]
  item_id        bigint       [ref: > inventory_act_items.id]
  image          varchar(255) [not null]
  caption        varchar(200)

  indexes {
    created_at
    deleted_at
    act_id
    item_id
    act_id [name: 'inventory_a_act_id_a9fcf8_idx']
  }
}

// iDeal DBML Domain: Maintenance (app: maintenance)

Table service_requests {
  id               bigint                       [pk, increment]
  created_at       timestamptz                  [not null]
  updated_at       timestamptz                  [not null]
  deleted_at       timestamptz                 
  restored_at      timestamptz                 
  transaction_id   uuid                        
  property_id      bigint                       [not null, ref: > properties.id]
  tenant_id        bigint                       [not null, ref: > users.id]
  assigned_to_id   bigint                       [ref: > users.id]
  title            varchar(200)                 [not null]
  description      text                         [not null]
  priority         servicerequest_priority      [not null, default: 'medium']
  status           servicerequest_status        [not null, default: 'open']
  cost             decimal(12, 2)              
  cost_bearer      service_requests_cost_bearer
  resolution_notes text                        
  resolved_at      timestamptz                 

  indexes {
    created_at
    deleted_at
    property_id
    tenant_id
    assigned_to_id
    property_id [name: 'service_req_propert_b0e641_idx']
    tenant_id [name: 'service_req_tenant__37066c_idx']
    status [name: 'service_req_status_ba17eb_idx']
    assigned_to_id [name: 'service_req_assigne_a3c572_idx']
  }
}

Table service_request_photos {
  id                 bigint       [pk, increment]
  created_at         timestamptz  [not null]
  updated_at         timestamptz  [not null]
  deleted_at         timestamptz 
  restored_at        timestamptz 
  transaction_id     uuid        
  service_request_id bigint       [not null, ref: > service_requests.id]
  image              varchar(255) [not null]

  indexes {
    created_at
    deleted_at
    service_request_id
  }
}

Table service_request_comments {
  id                 bigint      [pk, increment]
  created_at         timestamptz [not null]
  updated_at         timestamptz [not null]
  deleted_at         timestamptz
  restored_at        timestamptz
  transaction_id     uuid       
  service_request_id bigint      [not null, ref: > service_requests.id]
  author_id          bigint      [ref: > users.id]
  body               text        [not null]

  indexes {
    created_at
    deleted_at
    service_request_id
    author_id
    service_request_id [name: 'service_req_service_3f0b79_idx']
  }

  Note: '''
  An internal management/technician note on a service request.

Distinct from ``resolution_notes`` (a single post-resolution field): comments
form the running progress thread shown in the maintenance record panel.
  '''
}

// iDeal DBML Domain: Marketplace (app: marketplace)

Table listings {
  id                 bigint                [pk, increment]
  created_at         timestamptz           [not null]
  updated_at         timestamptz           [not null]
  deleted_at         timestamptz          
  restored_at        timestamptz          
  transaction_id     uuid                 
  property_id        bigint                [not null, unique, ref: - properties.id]
  owner_agreement_id bigint                [ref: > owner_agreements.id]
  status             listing_status        [not null, default: 'published']
  is_active          boolean               [not null, default: true]
  is_featured        boolean               [not null, default: false]
  description        text                 
  description_en     text                  [note: 'description [en]']
  description_uz     text                  [note: 'description [uz]']
  description_ru     text                  [note: 'description [ru]']
  listed_price       decimal(12, 2)       
  monthly_price      decimal(12, 2)       
  deposit_amount     decimal(12, 2)       
  currency           varchar(3)            [not null, default: 'USD']
  minimum_stay       listings_minimum_stay
  price_includes     jsonb                 [not null]
  rejection_reason   text                 
  submitted_at       timestamptz          
  published_at       timestamptz          

  indexes {
    created_at
    deleted_at
    owner_agreement_id
    is_active [name: 'listings_is_acti_fd46bf_idx']
    is_featured [name: 'listings_is_feat_01aa9f_idx']
    status [name: 'listings_status_c3eaec_idx']
  }
}

Table viewing_requests {
  id             bigint                          [pk, increment]
  created_at     timestamptz                     [not null]
  updated_at     timestamptz                     [not null]
  deleted_at     timestamptz                    
  restored_at    timestamptz                    
  transaction_id uuid                           
  listing_id     bigint                          [not null, ref: > listings.id]
  full_name      varchar(150)                    [not null]
  phone          varchar(30)                     [not null]
  email          varchar(254)                   
  preferred_date date                            [not null]
  preferred_time viewing_requests_preferred_time
  message        text                           
  status         viewingrequest_status           [not null, default: 'pending']

  indexes {
    created_at
    deleted_at
    listing_id
    listing_id [name: 'viewing_req_listing_139c85_idx']
    status [name: 'viewing_req_status_f29dc6_idx']
  }
}

Table contact_inquiries {
  id             bigint                [pk, increment]
  created_at     timestamptz           [not null]
  updated_at     timestamptz           [not null]
  deleted_at     timestamptz          
  restored_at    timestamptz          
  transaction_id uuid                 
  listing_id     bigint                [ref: > listings.id]
  full_name      varchar(150)          [not null]
  phone          varchar(30)           [not null]
  email          varchar(254)         
  message        text                  [not null]
  status         contactinquiry_status [not null, default: 'new']

  indexes {
    created_at
    deleted_at
    listing_id
    status [name: 'contact_inq_status_b7ab91_idx']
  }

  Note: '''
  A general "Message iDeal" inquiry from the public marketplace, kept separate from
ViewingRequest so management\'s viewing queue stays clean.
  '''
}

Table faq_items {
  id          bigint       [pk, increment]
  created_at  timestamptz  [not null]
  updated_at  timestamptz  [not null]
  question    varchar(255) [not null]
  question_en varchar(255) [note: 'question [en]']
  question_uz varchar(255) [note: 'question [uz]']
  question_ru varchar(255) [note: 'question [ru]']
  answer      text         [not null]
  answer_en   text         [note: 'answer [en]']
  answer_uz   text         [note: 'answer [uz]']
  answer_ru   text         [note: 'answer [ru]']
  sort_order  smallint     [not null, default: 0]
  is_active   boolean      [not null, default: true]

  indexes {
    created_at
  }

  Note: 'Editable FAQ entry shown on the public "How it works" page.'
}

Table bookings {
  id                   bigint         [pk, increment]
  created_at           timestamptz    [not null]
  updated_at           timestamptz    [not null]
  deleted_at           timestamptz   
  restored_at          timestamptz   
  transaction_id       uuid          
  listing_id           bigint         [not null, ref: > listings.id]
  property_id          bigint         [not null, ref: > properties.id]
  tenant_id            bigint         [not null, ref: > users.id]
  requested_start_date date           [not null]
  requested_end_date   date           [not null]
  monthly_rent_offer   decimal(12, 2)
  status               booking_status [not null, default: 'requested']
  message              text          
  reviewed_by_id       bigint         [ref: > users.id]
  converted_lease_id   bigint         [ref: > leases.id]

  indexes {
    created_at
    deleted_at
    listing_id
    property_id
    tenant_id
    reviewed_by_id
    converted_lease_id
    listing_id [name: 'bookings_listing_f5464a_idx']
    tenant_id [name: 'bookings_tenant__51b695_idx']
    status [name: 'bookings_status_51373b_idx']
  }

  Note: '''
  A logged-in tenant\'s reservation request against a listing (Smart Match).

Management approves a booking and converts it into a Lease (reusing the
existing lease-creation logic, which frees/occupies the property).
  '''
}

Table favorite_listings {
  id             bigint      [pk, increment]
  created_at     timestamptz [not null]
  updated_at     timestamptz [not null]
  deleted_at     timestamptz
  restored_at    timestamptz
  transaction_id uuid       
  user_id        bigint      [not null, ref: > users.id]
  listing_id     bigint      [not null, ref: > listings.id]

  indexes {
    created_at
    deleted_at
    user_id
    listing_id
    (user_id, created_at) [name: 'favorite_li_user_id_5e150f_idx']
    (listing_id, created_at) [name: 'favorite_li_listing_c857d4_idx']
  }
}

Table booking_quotes {
  id                bigint         [pk, increment]
  created_at        timestamptz    [not null]
  updated_at        timestamptz    [not null]
  deleted_at        timestamptz   
  restored_at       timestamptz   
  transaction_id    uuid          
  listing_id        bigint         [not null, ref: > listings.id]
  tenant_id         bigint         [not null, ref: > users.id]
  start_date        date           [not null]
  end_date          date           [not null]
  currency          varchar(3)     [not null]
  monthly_rent      decimal(12, 2) [not null]
  deposit_amount    decimal(12, 2) [not null]
  first_period_rent decimal(12, 2) [not null]
  full_stay_rent    decimal(12, 2) [not null]
  first_month_total decimal(12, 2) [not null]
  full_stay_total   decimal(12, 2) [not null]
  periods           jsonb          [not null]
  agreement_ids     jsonb          [not null]
  fx_rate           decimal(18, 6)
  expires_at        timestamptz    [not null]

  indexes {
    created_at
    deleted_at
    listing_id
    tenant_id
    (listing_id, expires_at) [name: 'booking_quo_listing_d87514_idx']
    (tenant_id, expires_at) [name: 'booking_quo_tenant__0ea199_idx']
  }
}

Table payment_checkouts {
  id                bigint                     [pk, increment]
  created_at        timestamptz                [not null]
  updated_at        timestamptz                [not null]
  deleted_at        timestamptz               
  restored_at       timestamptz               
  transaction_id    uuid                      
  quote_id          bigint                     [not null, ref: > booking_quotes.id]
  booking_id        bigint                     [not null, unique, ref: - bookings.id]
  tenant_id         bigint                     [not null, ref: > users.id]
  public_token      uuid                       [not null, unique, default: `gen_random_uuid()`]
  idempotency_key   varchar(128)               [not null]
  provider          payment_checkouts_provider [not null]
  status            paymentcheckout_status     [not null, default: 'pending']
  pay_full_stay     boolean                    [not null, default: false]
  original_amount   decimal(12, 2)             [not null]
  original_currency varchar(3)                 [not null]
  provider_amount   decimal(18, 2)             [not null]
  provider_currency varchar(3)                 [not null]
  fx_rate           decimal(18, 6)            
  checkout_url      varchar(1000)              [not null]
  external_id       varchar(255)              
  expires_at        timestamptz                [not null]
  completed_at      timestamptz               

  indexes {
    created_at
    deleted_at
    quote_id
    tenant_id
    (status, expires_at) [name: 'payment_che_status_653ff1_idx']
    (provider, external_id) [name: 'payment_che_provide_6e7802_idx']
  }
}

Table provider_events {
  id                bigint                   [pk, increment]
  created_at        timestamptz              [not null]
  updated_at        timestamptz              [not null]
  deleted_at        timestamptz             
  restored_at       timestamptz             
  transaction_id    uuid                    
  checkout_id       bigint                   [not null, ref: > payment_checkouts.id]
  provider          provider_events_provider [not null]
  external_event_id varchar(255)             [not null]
  event_type        varchar(100)             [not null]
  payload           jsonb                    [not null]
  result            jsonb                    [not null]

  indexes {
    created_at
    deleted_at
    checkout_id
  }
}

Table recent_search_activities {
  id             bigint       [pk, increment]
  created_at     timestamptz  [not null]
  updated_at     timestamptz  [not null]
  deleted_at     timestamptz 
  restored_at    timestamptz 
  transaction_id uuid        
  user_id        bigint       [not null, ref: > users.id]
  query          varchar(255) [not null, default: '']
  filters        jsonb        [not null]
  fingerprint    varchar(64)  [not null]

  indexes {
    created_at
    deleted_at
    user_id
    fingerprint
    (user_id, updated_at) [name: 'recent_sear_user_id_a4e6a5_idx']
  }
}

Table listing_view_activities {
  id             bigint      [pk, increment]
  created_at     timestamptz [not null]
  updated_at     timestamptz [not null]
  deleted_at     timestamptz
  restored_at    timestamptz
  transaction_id uuid       
  user_id        bigint      [not null, ref: > users.id]
  listing_id     bigint      [not null, ref: > listings.id]

  indexes {
    created_at
    deleted_at
    user_id
    listing_id
    (user_id, updated_at) [name: 'listing_vie_user_id_630077_idx']
    (listing_id, updated_at) [name: 'listing_vie_listing_1660f9_idx']
  }
}

// iDeal DBML Domain: Mobile_config (app: mobile_config)

Table mobile_update_policies {
  id             bigint               [pk, increment]
  created_at     timestamptz          [not null]
  updated_at     timestamptz          [not null]
  platform       devicetoken_platform [not null]
  latest_version varchar(32)          [not null]
  store_url      varchar(500)         [not null]
  is_active      boolean              [not null, default: true]

  indexes {
    created_at
    platform
    is_active
  }
}

Table mobile_critical_update_ranges {
  id              bigint      [pk, increment]
  created_at      timestamptz [not null]
  updated_at      timestamptz [not null]
  policy_id       bigint      [not null, ref: > mobile_update_policies.id]
  minimum_version varchar(32) [not null]
  maximum_version varchar(32) [not null]
  is_active       boolean     [not null, default: true]

  indexes {
    created_at
    policy_id
    is_active
  }
}

// iDeal DBML Domain: Notification (app: notification)

Table notifications {
  id                  bigint                 [pk, increment]
  created_at          timestamptz            [not null]
  updated_at          timestamptz            [not null]
  deleted_at          timestamptz           
  restored_at         timestamptz           
  transaction_id      uuid                  
  recipient_id        bigint                 [not null, ref: > users.id]
  type                notifications_type     [not null, default: 'general']
  audience            notifications_audience [not null, default: 'both']
  title               varchar(200)           [not null]
  title_en            varchar(200)           [note: 'Title [en]']
  title_uz            varchar(200)           [note: 'Title [uz]']
  title_ru            varchar(200)           [note: 'Title [ru]']
  body                text                  
  body_en             text                   [note: 'Body [en]']
  body_uz             text                   [note: 'Body [uz]']
  body_ru             text                   [note: 'Body [ru]']
  related_object_type varchar(50)           
  related_object_id   integer               
  is_read             boolean                [not null, default: false]
  read_at             timestamptz           

  indexes {
    created_at
    deleted_at
    recipient_id
    audience
    is_read
    recipient_id [name: 'notificatio_recipie_1dd18d_idx']
    is_read [name: 'notificatio_is_read_3f8c44_idx']
    type [name: 'notificatio_type_8a8a78_idx']
  }
}

Table notification_device_tokens {
  id             bigint               [pk, increment]
  created_at     timestamptz          [not null]
  updated_at     timestamptz          [not null]
  deleted_at     timestamptz         
  restored_at    timestamptz         
  transaction_id uuid                
  user_id        bigint               [not null, ref: > users.id]
  token          text                 [not null, unique]
  platform       devicetoken_platform [not null]
  device_id      varchar(255)        
  app_version    varchar(50)         
  locale         varchar(10)         
  is_active      boolean              [not null, default: true]
  last_seen_at   timestamptz         

  indexes {
    created_at
    deleted_at
    user_id
    is_active
    user_id [name: 'notificatio_user_id_77f2f2_idx']
    (user_id, is_active) [name: 'notificatio_user_id_93f131_idx']
  }
}

Table notification_preferences {
  id                  bigint      [pk, increment]
  created_at          timestamptz [not null]
  updated_at          timestamptz [not null]
  deleted_at          timestamptz
  restored_at         timestamptz
  transaction_id      uuid       
  user_id             bigint      [not null, unique, ref: - users.id]
  push_enabled        boolean     [not null, default: true]
  payments_enabled    boolean     [not null, default: true]
  bookings_enabled    boolean     [not null, default: true]
  maintenance_enabled boolean     [not null, default: true]
  leases_enabled      boolean     [not null, default: true]
  messages_enabled    boolean     [not null, default: true]
  general_enabled     boolean     [not null, default: true]

  indexes {
    created_at
    deleted_at
  }
}

// iDeal DBML Domain: Property (app: property)

Table districts {
  id             bigint       [pk, increment]
  created_at     timestamptz  [not null]
  updated_at     timestamptz  [not null]
  deleted_at     timestamptz 
  restored_at    timestamptz 
  transaction_id uuid        
  name           varchar(100) [not null, unique]
  name_en        varchar(100) [unique, note: 'name [en]']
  name_uz        varchar(100) [unique, note: 'name [uz]']
  name_ru        varchar(100) [unique, note: 'name [ru]']
  city           varchar(100) [not null, default: 'Toshkent']
  city_en        varchar(100) [default: 'Toshkent', note: 'city [en]']
  city_uz        varchar(100) [default: 'Toshkent', note: 'city [uz]']
  city_ru        varchar(100) [default: 'Toshkent', note: 'city [ru]']

  indexes {
    created_at
    deleted_at
  }
}

Table amenities {
  id         bigint       [pk, increment]
  created_at timestamptz  [not null]
  updated_at timestamptz  [not null]
  slug       varchar(50)  [not null, unique]
  name       varchar(100) [not null]
  name_en    varchar(100) [note: 'name [en]']
  name_uz    varchar(100) [note: 'name [uz]']
  name_ru    varchar(100) [note: 'name [ru]']
  icon       varchar(50)  [not null]
  sort_order smallint     [not null, default: 0]
  is_active  boolean      [not null, default: true]

  indexes {
    created_at
  }

  Note: '''
  Lookup of property amenities — single source of truth for the wizard chip-set
and the listing-detail labelled grid.
  '''
}

Table properties {
  id                        bigint                     [pk, increment]
  created_at                timestamptz                [not null]
  updated_at                timestamptz                [not null]
  deleted_at                timestamptz               
  restored_at               timestamptz               
  transaction_id            uuid                      
  name                      varchar(200)               [not null]
  name_en                   varchar(200)               [note: 'name [en]']
  name_uz                   varchar(200)               [note: 'name [uz]']
  name_ru                   varchar(200)               [note: 'name [ru]']
  address                   varchar(255)               [not null, default: '']
  landmark                  varchar(100)              
  landmark_en               varchar(100)               [note: 'landmark [en]']
  landmark_uz               varchar(100)               [note: 'landmark [uz]']
  landmark_ru               varchar(100)               [note: 'landmark [ru]']
  district_id               bigint                     [ref: > districts.id]
  property_type             properties_property_type   [not null, default: 'apartment']
  rooms                     smallint                  
  area_sqm                  smallint                  
  floor                     smallint                  
  total_floors              smallint                  
  furnishing                properties_furnishing      [not null, default: 'unfurnished']
  owner_id                  bigint                     [ref: > users.id]
  created_by_id             bigint                     [ref: > users.id]
  contact_phone             varchar(30)               
  engagement_type           properties_engagement_type [not null, default: 'managed']
  status                    property_status            [not null, default: 'vacant']
  is_verified               boolean                    [not null, default: false]
  verified_at               timestamptz               
  verified_by_id            bigint                     [ref: > users.id]
  score                     decimal(3, 1)              [not null, default: 0.0]
  review_count              integer                    [not null, default: 0]
  map_lat                   decimal(10, 7)            
  map_lon                   decimal(10, 7)            
  description               text                      
  description_en            text                       [note: 'description [en]']
  description_uz            text                       [note: 'description [uz]']
  description_ru            text                       [note: 'description [ru]']
  tariff                    properties_tariff          [not null, default: 'standard']
  ask_price                 decimal(12, 2)            
  ask_currency              varchar(3)                 [not null, default: 'USD']
  owner_guaranteed_price    decimal(12, 2)            
  owner_guaranteed_currency varchar(3)                 [not null, default: 'USD']
  tenant_charge_price       decimal(12, 2)            
  tenant_charge_currency    varchar(3)                 [not null, default: 'USD']
  deposit_amount            decimal(12, 2)            
  deposit_currency          varchar(3)                 [not null, default: 'USD']
  vacant_since              date                      
  vacant_days               smallint                   [not null, default: 0]

  indexes {
    created_at
    deleted_at
    district_id
    owner_id
    created_by_id
    engagement_type
    verified_by_id
    district_id [name: 'properties_distric_49eaea_idx']
    owner_id [name: 'properties_owner_i_921947_idx']
    status [name: 'properties_status_e6008a_idx']
    (map_lat, map_lon) [name: 'properties_map_lat_6ee7c6_idx']
    (engagement_type, status) [name: 'properties_engagem_5e9f4f_idx']
  }
}

Table one_off_deals {
  id                         bigint                            [pk, increment]
  created_at                 timestamptz                       [not null]
  updated_at                 timestamptz                       [not null]
  deleted_at                 timestamptz                      
  restored_at                timestamptz                      
  transaction_id             uuid                             
  property_id                bigint                            [not null, unique, ref: - properties.id]
  seller_name                varchar(150)                      [not null]
  seller_phone               varchar(30)                       [not null]
  seller_email               varchar(254)                     
  renter_name                varchar(150)                     
  renter_phone               varchar(30)                      
  renter_email               varchar(254)                     
  channel                    one_off_deals_channel             [not null]
  status                     oneoffdeal_status                 [not null, default: 'active']
  commission_type            one_off_deals_commission_type     [not null, default: 'none']
  commission_fixed_amount    decimal(12, 2)                   
  commission_percentage      decimal(5, 2)                    
  commission_currency        one_off_deals_commission_currency [not null, default: 'USD']
  agreed_monthly_rent        decimal(12, 2)                   
  agreed_currency            one_off_deals_agreed_currency     [not null, default: 'USD']
  close_date                 date                             
  close_notes                text                              [not null, default: '']
  evidence                   jsonb                             [not null]
  commission_amount          decimal(12, 2)                   
  commission_uzs_amount      decimal(16, 2)                   
  commission_conversion_rate decimal(18, 6)                   
  closed_by_id               bigint                            [ref: > users.id]

  indexes {
    created_at
    deleted_at
    status
    closed_by_id
    status [name: 'one_off_dea_status_dd8c3d_idx']
    (channel, status) [name: 'one_off_dea_channel_349c58_idx']
  }

  Note: 'Staff-operated brokerage deal with contact snapshots, never portal users.'
}

Table one_off_commission_receipts {
  id             bigint                            [pk, increment]
  created_at     timestamptz                       [not null]
  updated_at     timestamptz                       [not null]
  deal_id        bigint                            [not null, unique, ref: - one_off_deals.id]
  amount         decimal(12, 2)                    [not null]
  currency       one_off_deals_commission_currency [not null]
  received_date  date                              [not null]
  method         oneoffcommissionreceipt_method    [not null]
  reference      varchar(128)                      [not null, default: '']
  recorded_by_id bigint                            [not null, ref: > users.id]

  indexes {
    created_at
    recorded_by_id
  }

  Note: 'The single full collection for a closed one-off commission.'
}

Table one_off_commission_receipt_attachments {
  id           bigint       [pk, increment]
  created_at   timestamptz  [not null]
  updated_at   timestamptz  [not null]
  receipt_id   bigint       [not null, ref: > one_off_commission_receipts.id]
  file         varchar(255) [not null]
  filename     varchar(255) [not null]
  content_type varchar(100) [not null, default: '']
  size_bytes   integer      [not null, default: 0]

  indexes {
    created_at
    receipt_id
  }

  Note: 'A staff-only source document supporting a received brokerage commission.'
}

Table property_photos {
  id            bigint       [pk, increment]
  created_at    timestamptz  [not null]
  updated_at    timestamptz  [not null]
  property_id   bigint       [not null, ref: > properties.id]
  image         varchar(255) [not null]
  preview_image varchar(255)
  display_image varchar(255)
  caption       varchar(120) [not null, default: '']
  caption_en    varchar(120) [default: '', note: 'Caption [en]']
  caption_uz    varchar(120) [default: '', note: 'Caption [uz]']
  caption_ru    varchar(120) [default: '', note: 'Caption [ru]']
  is_primary    boolean      [not null, default: false]
  sort_order    smallint     [not null, default: 0]

  indexes {
    created_at
    property_id
  }
}

Table verification_visits {
  id              bigint                   [pk, increment]
  created_at      timestamptz              [not null]
  updated_at      timestamptz              [not null]
  property_id     bigint                   [not null, ref: > properties.id]
  scheduled_for   timestamptz              [not null]
  status          verificationvisit_status [not null, default: 'scheduled']
  scheduled_by_id bigint                   [ref: > users.id]
  completed_at    timestamptz             
  notes           text                     [not null, default: '']

  indexes {
    created_at
    property_id
    scheduled_by_id
  }

  Note: '''
  A management on-site verification visit scheduled when a property is
published. Backs the "Save & schedule verification" action and the publish
checklist\'s verification row.
  '''
}

// Junction Tables
Table properties_amenities {
  id bigint [pk, increment]
  property_id bigint [not null, ref: > properties.id]
  amenity_id bigint [not null, ref: > amenities.id]

  indexes {
    (property_id, amenity_id) [unique]
  }

  Note: 'Auto-created junction table for properties.amenities -> amenities'
}

// iDeal DBML Domain: Vas (app: vas)

Table vas_catalog_items {
  id              bigint                            [pk, increment]
  created_at      timestamptz                       [not null]
  updated_at      timestamptz                       [not null]
  deleted_at      timestamptz                      
  restored_at     timestamptz                      
  transaction_id  uuid                             
  service_type    vas_catalog_items_service_type    [not null, default: 'other']
  name            varchar(150)                      [not null]
  name_en         varchar(150)                      [note: 'Name [en]']
  name_uz         varchar(150)                      [note: 'Name [uz]']
  name_ru         varchar(150)                      [note: 'Name [ru]']
  partner_name    varchar(150)                     
  description     text                             
  description_en  text                              [note: 'Description [en]']
  description_uz  text                              [note: 'Description [uz]']
  description_ru  text                              [note: 'Description [ru]']
  base_price      decimal(12, 2)                    [not null]
  currency        one_off_deals_commission_currency [not null, default: 'USD']
  commission_rate decimal(5, 2)                     [not null]
  cashback_rate   decimal(5, 2)                     [not null]
  is_active       boolean                           [not null, default: true]

  indexes {
    created_at
    deleted_at
    service_type [name: 'vas_catalog_service_c03b12_idx']
    is_active [name: 'vas_catalog_is_acti_428362_idx']
  }

  Note: 'A value-added service the platform offers (cleaning, handyman, utilities…).'
}

Table vas_orders {
  id                  bigint                            [pk, increment]
  created_at          timestamptz                       [not null]
  updated_at          timestamptz                       [not null]
  deleted_at          timestamptz                      
  restored_at         timestamptz                      
  transaction_id      uuid                             
  catalog_item_id     bigint                            [not null, ref: > vas_catalog_items.id]
  tenant_id           bigint                            [not null, ref: > users.id]
  property_id         bigint                            [not null, ref: > properties.id]
  lease_id            bigint                            [ref: > leases.id]
  status              serviceorder_status               [not null, default: 'requested']
  cost                decimal(12, 2)                    [not null]
  currency            one_off_deals_commission_currency [not null, default: 'USD']
  commission_earned   decimal(12, 2)                    [not null]
  cashback_amount     decimal(12, 2)                    [not null]
  scheduled_for       date                             
  notes               text                             
  cancellation_reason text                             
  completed_at        timestamptz                      

  indexes {
    created_at
    deleted_at
    catalog_item_id
    tenant_id
    property_id
    lease_id
    tenant_id [name: 'vas_orders_tenant__387c51_idx']
    property_id [name: 'vas_orders_propert_271ed0_idx']
    status [name: 'vas_orders_status_d7f358_idx']
  }
}

